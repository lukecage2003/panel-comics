<?xml version="1.0" encoding="utf-8"?>
<!-- Stabilisation S1 : aucune donnée de Panel (collection, identifiants Metron, clé Comic Vine, session) n'est copiée
     par la sauvegarde Google ni par le transfert vers un nouvel appareil. Les sauvegardes passent par l'export de Panel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
